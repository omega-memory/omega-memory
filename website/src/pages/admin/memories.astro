---
import Admin from "../../layouts/Admin.astro";
import { getDb } from "../../lib/db";
import { memories } from "../../lib/db/schema";
import { count, desc, eq, like, and, sql } from "drizzle-orm";

const db = getDb(Astro);

// Parse query params
const page = Math.max(1, parseInt(Astro.url.searchParams.get("page") ?? "1"));
const perPage = 50;
const search = Astro.url.searchParams.get("q") ?? "";
const eventType = Astro.url.searchParams.get("event_type") ?? "";
const project = Astro.url.searchParams.get("project") ?? "";

// Build conditions
const conditions = [];
if (search) {
  conditions.push(like(memories.content, `%${search}%`));
}
if (eventType) {
  conditions.push(eq(memories.eventType, eventType));
}
if (project) {
  conditions.push(eq(memories.project, project));
}

const whereClause = conditions.length > 0 ? and(...conditions) : undefined;

// Fetch data
const [totalRow] = await db
  .select({ value: count() })
  .from(memories)
  .where(whereClause);
const total = totalRow.value;
const totalPages = Math.max(1, Math.ceil(total / perPage));

const rows = await db
  .select()
  .from(memories)
  .where(whereClause)
  .orderBy(desc(memories.createdAt))
  .limit(perPage)
  .offset((page - 1) * perPage);

// Fetch distinct event types and projects for filters
const eventTypes = await db
  .selectDistinct({ value: memories.eventType })
  .from(memories)
  .where(sql`${memories.eventType} IS NOT NULL`)
  .limit(50);

const projects = await db
  .selectDistinct({ value: memories.project })
  .from(memories)
  .where(sql`${memories.project} IS NOT NULL`)
  .limit(50);

function buildUrl(params: Record<string, string>) {
  const u = new URL(Astro.url);
  for (const [k, v] of Object.entries(params)) {
    if (v) u.searchParams.set(k, v);
    else u.searchParams.delete(k);
  }
  return u.pathname + u.search;
}
---

<Admin title="Memories">
  <div class="p-6 space-y-4">
    <header class="flex items-center justify-between">
      <h1 class="text-2xl font-semibold">Memories</h1>
      <span class="text-sm text-[var(--ink-faint)]">{total.toLocaleString()} total</span>
    </header>

    <!-- Filters -->
    <form method="GET" class="filter-bar">
      <input
        type="text"
        name="q"
        placeholder="Search content..."
        value={search}
        class="filter-input flex-1"
      />
      <select name="event_type" class="filter-select">
        <option value="">All types</option>
        {eventTypes.map((t) => (
          <option value={t.value ?? ""} selected={t.value === eventType}>{t.value}</option>
        ))}
      </select>
      <select name="project" class="filter-select">
        <option value="">All projects</option>
        {projects.map((p) => (
          <option value={p.value ?? ""} selected={p.value === project}>{p.value}</option>
        ))}
      </select>
      <button type="submit" class="filter-btn">Filter</button>
      {(search || eventType || project) && (
        <a href="/admin/memories" class="filter-clear">Clear</a>
      )}
    </form>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Node ID</th>
            <th>Type</th>
            <th>Project</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Created</th>
            <th>Content</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((m) => (
            <tr>
              <td class="font-mono text-xs text-[var(--ink-faint)]">{m.id}</td>
              <td class="font-mono text-xs">{m.nodeId.slice(0, 12)}...</td>
              <td>
                <span class:list={["event-badge", `badge-${m.eventType ?? "unknown"}`]}>
                  {m.eventType ?? "—"}
                </span>
              </td>
              <td class="text-[var(--ink-secondary)]">{m.project ?? "—"}</td>
              <td class="text-center">{m.priority ?? 3}</td>
              <td>
                <span class:list={["health-dot", m.status === "active" ? "dot-ok" : "dot-warn"]}></span>
              </td>
              <td class="text-xs text-[var(--ink-faint)] whitespace-nowrap">{m.createdAt?.slice(0, 16)}</td>
              <td class="max-w-sm truncate text-sm">{m.content.slice(0, 100)}</td>
            </tr>
          ))}
          {rows.length === 0 && (
            <tr>
              <td colspan="8" class="text-center text-[var(--ink-faint)] py-8">
                {search || eventType || project ? "No memories match your filters." : "No memories yet."}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="pagination">
        {page > 1 && (
          <a href={buildUrl({ page: String(page - 1), q: search, event_type: eventType, project })} class="page-link">Prev</a>
        )}
        <span class="page-info">Page {page} of {totalPages}</span>
        {page < totalPages && (
          <a href={buildUrl({ page: String(page + 1), q: search, event_type: eventType, project })} class="page-link">Next</a>
        )}
      </nav>
    )}
  </div>

  <style>
    .filter-bar {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      flex-wrap: wrap;
    }
    .filter-input, .filter-select {
      background: var(--surface-0);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.45rem 0.65rem;
      color: var(--ink-primary);
      font-size: 0.85rem;
      font-family: var(--font-sans);
      outline: none;
      transition: border-color 0.2s;
    }
    .filter-input:focus, .filter-select:focus {
      border-color: var(--accent-dim);
    }
    .filter-select {
      min-width: 130px;
    }
    .filter-btn {
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.45rem 1rem;
      color: var(--ink-primary);
      font-size: 0.85rem;
      font-family: var(--font-sans);
      cursor: pointer;
      transition: background 0.2s;
    }
    .filter-btn:hover { background: var(--surface-3); }
    .filter-clear {
      font-size: 0.8rem;
      color: var(--ink-faint);
      text-decoration: none;
    }
    .filter-clear:hover { color: var(--error); }

    .data-table {
      width: 100%;
      border-collapse: collapse;
    }
    .data-table th {
      text-align: left;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-faint);
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--border);
    }
    .data-table td {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      border-bottom: 1px solid var(--border);
      color: var(--ink-primary);
    }
    .data-table tr:hover td { background: var(--surface-1); }

    .event-badge {
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      font-weight: 500;
      background: var(--surface-2);
      color: var(--ink-secondary);
    }
    .badge-decision { color: var(--decision); background: rgba(107, 159, 255, 0.1); }
    .badge-lesson { color: var(--lesson); background: rgba(94, 201, 160, 0.1); }
    .badge-reminder { color: var(--reminder); background: rgba(232, 160, 64, 0.1); }
    .badge-preference { color: var(--preference); background: rgba(176, 136, 232, 0.1); }
    .badge-task { color: var(--task); background: rgba(64, 200, 200, 0.1); }

    .health-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }
    .dot-ok { background: var(--lesson); }
    .dot-warn { background: var(--reminder); }

    .pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      padding-top: 0.5rem;
    }
    .page-link {
      color: var(--accent);
      text-decoration: none;
      font-size: 0.875rem;
    }
    .page-link:hover { text-decoration: underline; }
    .page-info {
      font-size: 0.8rem;
      color: var(--ink-faint);
    }
  </style>
</Admin>
