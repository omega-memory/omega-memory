---
import Admin from "../../layouts/Admin.astro";
import { getDb } from "../../lib/db";
import { coordSessions, coordFileClaims, users } from "../../lib/db/schema";
import { desc, eq, isNull } from "drizzle-orm";

const db = getDb(Astro);

// Active coordination sessions
const activeSessions = await db
  .select({
    id: coordSessions.id,
    agentType: coordSessions.agentType,
    startedAt: coordSessions.startedAt,
    status: coordSessions.status,
    metadata: coordSessions.metadata,
    userId: coordSessions.userId,
  })
  .from(coordSessions)
  .where(eq(coordSessions.status, "active"))
  .orderBy(desc(coordSessions.startedAt))
  .limit(50);

// Recent completed sessions
const recentSessions = await db
  .select({
    id: coordSessions.id,
    agentType: coordSessions.agentType,
    startedAt: coordSessions.startedAt,
    endedAt: coordSessions.endedAt,
    status: coordSessions.status,
  })
  .from(coordSessions)
  .orderBy(desc(coordSessions.startedAt))
  .limit(20);

// Active file claims (not yet released)
const activeClaims = await db
  .select({
    id: coordFileClaims.id,
    sessionId: coordFileClaims.sessionId,
    filePath: coordFileClaims.filePath,
    claimType: coordFileClaims.claimType,
    claimedAt: coordFileClaims.claimedAt,
  })
  .from(coordFileClaims)
  .where(isNull(coordFileClaims.releasedAt))
  .orderBy(desc(coordFileClaims.claimedAt))
  .limit(50);
---

<Admin title="Coordination">
  <div class="p-6 space-y-6">
    <header>
      <h1 class="text-2xl font-semibold">Coordination</h1>
      <p class="text-sm text-[var(--ink-faint)] mt-1">Agent sessions and file claims</p>
    </header>

    <!-- Active Sessions -->
    <section>
      <h2 class="section-title">
        Active Sessions
        <span class="count-badge">{activeSessions.length}</span>
      </h2>
      {activeSessions.length > 0 ? (
        <div class="grid gap-3">
          {activeSessions.map((s) => (
            <div class="session-card">
              <div class="flex items-center gap-3">
                <span class="health-dot dot-ok"></span>
                <span class="font-mono text-sm">{s.id.slice(0, 8)}</span>
                {s.agentType && (
                  <span class="agent-badge">{s.agentType}</span>
                )}
              </div>
              <div class="text-xs text-[var(--ink-faint)] mt-1">
                Started {s.startedAt ?? "unknown"}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-state">No active sessions</div>
      )}
    </section>

    <!-- Active File Claims -->
    <section>
      <h2 class="section-title">
        File Claims
        <span class="count-badge">{activeClaims.length}</span>
      </h2>
      {activeClaims.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="data-table">
            <thead>
              <tr>
                <th>File Path</th>
                <th>Type</th>
                <th>Session</th>
                <th>Claimed At</th>
              </tr>
            </thead>
            <tbody>
              {activeClaims.map((c) => (
                <tr>
                  <td class="font-mono text-sm">{c.filePath}</td>
                  <td>
                    <span class:list={["claim-badge", c.claimType === "write" ? "claim-write" : "claim-read"]}>
                      {c.claimType ?? "write"}
                    </span>
                  </td>
                  <td class="font-mono text-xs text-[var(--ink-faint)]">{c.sessionId?.slice(0, 8)}...</td>
                  <td class="text-xs text-[var(--ink-faint)]">{c.claimedAt?.slice(0, 16)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state">No active file claims</div>
      )}
    </section>

    <!-- Recent Sessions -->
    <section>
      <h2 class="section-title">Recent Sessions</h2>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Agent</th>
              <th>Status</th>
              <th>Started</th>
              <th>Ended</th>
            </tr>
          </thead>
          <tbody>
            {recentSessions.map((s) => (
              <tr>
                <td class="font-mono text-xs">{s.id.slice(0, 12)}...</td>
                <td>{s.agentType ?? "—"}</td>
                <td>
                  <span class:list={["status-badge", `status-${s.status}`]}>
                    {s.status ?? "unknown"}
                  </span>
                </td>
                <td class="text-xs text-[var(--ink-faint)]">{s.startedAt?.slice(0, 16)}</td>
                <td class="text-xs text-[var(--ink-faint)]">{s.endedAt?.slice(0, 16) ?? "—"}</td>
              </tr>
            ))}
            {recentSessions.length === 0 && (
              <tr>
                <td colspan="5" class="text-center text-[var(--ink-faint)] py-8">No sessions recorded</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <style>
    .section-title {
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink-secondary);
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .count-badge {
      font-size: 0.7rem;
      background: var(--surface-2);
      color: var(--ink-faint);
      padding: 0.1rem 0.45rem;
      border-radius: 4px;
    }
    .session-card {
      background: var(--surface-1);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.75rem 1rem;
    }
    .health-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }
    .dot-ok { background: var(--lesson); }
    .agent-badge {
      font-size: 0.7rem;
      padding: 0.1rem 0.45rem;
      border-radius: 4px;
      background: rgba(64, 200, 200, 0.1);
      color: var(--task);
    }
    .empty-state {
      text-align: center;
      color: var(--ink-faint);
      padding: 2rem;
      background: var(--surface-1);
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.875rem;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
    }
    .data-table th {
      text-align: left;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-faint);
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--border);
    }
    .data-table td {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      border-bottom: 1px solid var(--border);
      color: var(--ink-primary);
    }
    .data-table tr:hover td { background: var(--surface-1); }

    .claim-badge {
      font-size: 0.7rem;
      padding: 0.1rem 0.45rem;
      border-radius: 4px;
      font-weight: 500;
    }
    .claim-write { background: rgba(240, 96, 96, 0.1); color: var(--error); }
    .claim-read { background: rgba(107, 159, 255, 0.1); color: var(--decision); }

    .status-badge {
      font-size: 0.7rem;
      padding: 0.1rem 0.45rem;
      border-radius: 4px;
    }
    .status-active { background: rgba(94, 201, 160, 0.1); color: var(--lesson); }
    .status-completed { background: rgba(107, 159, 255, 0.1); color: var(--decision); }
    .status-failed { background: rgba(240, 96, 96, 0.1); color: var(--error); }
  </style>
</Admin>
