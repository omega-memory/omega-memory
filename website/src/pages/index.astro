---
import Base from "../layouts/Base.astro";
---

<Base title="OMEGA — Local-First Intelligence Layer for AI Agents">
  <!-- Full-page starfield canvas — fixed behind everything, matches production -->
  <canvas class="fixed inset-0 pointer-events-none" id="starfield" style="z-index: 0;"></canvas>

  <main style="position: relative; z-index: 1;">
    <h1 class="sr-only">OMEGA — Local-First Intelligence Layer for AI Agents</h1>

    <!-- ============================================================
         HERO — Left-aligned text + Three.js 3D force graph
         ============================================================ -->
    <section class="relative h-screen overflow-hidden">
      <!-- Three.js 3D graph + orbs container (full bleed, behind overlays) -->
      <div class="absolute inset-0" id="hero-graph" style="z-index: 5;"></div>

      <!-- Gradient overlays matching production — protect text readability -->
      <div class="absolute inset-0 pointer-events-none" style="z-index: 10; background: linear-gradient(90deg, rgba(8,9,15,0.92) 0%, rgba(8,9,15,0.75) 35%, rgba(8,9,15,0.2) 60%, transparent 80%);"></div>
      <div class="absolute inset-0 pointer-events-none" style="z-index: 10; background: linear-gradient(transparent 70%, rgb(8,9,15) 100%);"></div>
      <div class="absolute inset-0 pointer-events-none" style="z-index: 10; background: linear-gradient(rgba(8,9,15,0.4) 0%, transparent 12%);"></div>

      <!-- Hero text content — left aligned, above overlays -->
      <div class="absolute inset-0 flex items-center pointer-events-none" style="z-index: 15;">
        <div class="max-w-6xl mx-auto px-6 w-full">
          <div class="max-w-xl pt-24 pointer-events-auto">
            <p class="font-mono tracking-[0.2em] uppercase mb-8" style="font-size: 12px; color: var(--accent); opacity: 0.7;">Local-First Agent Intelligence</p>

            <h2 class="font-light mb-6" style="font-family: var(--font-sans); font-size: clamp(2.8rem, 5.5vw, 4.2rem); line-height: 1.12; letter-spacing: -0.02em; color: rgba(255,255,255,0.95);">
              Sovereign<br/>Intelligence<br/>
              <span style="color: var(--accent); text-shadow: 0 0 60px rgba(212,168,67,0.4), 0 0 120px rgba(212,168,67,0.15);">for AI Agents.</span>
            </h2>

            <p class="mb-8" style="font-size: 16px; color: rgba(255,255,255,0.4); line-height: 1.7; max-width: 400px;">
              The LLM is rented. The intelligence is owned. OMEGA runs entirely on your machine.
            </p>

            <!-- Install command -->
            <div class="mb-6 px-5 py-3 rounded-md font-mono inline-block" style="font-size: 13px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); color: rgba(255,255,255,0.5);">
              <span style="color: var(--accent);">$</span> pip install omega-memory && omega setup
            </div>

            <!-- CTA buttons — matching production -->
            <div class="flex flex-wrap items-center gap-3 mb-8">
              <a href="/downloads" class="cta-gold font-mono uppercase tracking-wider !text-xs !py-3 !px-6" style="border-radius: 6px;">
                Install Free — No Cloud Required
              </a>
              <a href="https://github.com/omega-memory/omega-memory" class="cta-outline font-mono uppercase tracking-wider !text-xs !py-3 !px-6" style="border-radius: 6px; color: rgba(255,255,255,0.4); border-color: rgba(255,255,255,0.1);">
                <span style="color: var(--accent);">&#9733;</span>&nbsp; Star on GitHub
              </a>
            </div>

            <!-- Works with -->
            <div class="flex flex-wrap items-center gap-4 mb-3">
              <span class="font-mono uppercase tracking-wider" style="font-size: 10px; color: rgba(255,255,255,0.2);">Works with</span>
              <a href="/downloads" class="flex items-center gap-1.5 font-mono hover:text-white transition-colors" style="font-size: 12px; color: rgba(255,255,255,0.35);">
                <span style="color: var(--accent);">&gt;_</span> Claude Code
              </a>
              <a href="/downloads" class="flex items-center gap-1.5 font-mono hover:text-white transition-colors" style="font-size: 12px; color: rgba(255,255,255,0.35);">
                <span style="color: var(--accent);">&#9654;</span> Cursor
              </a>
              <a href="/downloads" class="flex items-center gap-1.5 font-mono hover:text-white transition-colors" style="font-size: 12px; color: rgba(255,255,255,0.35);">
                <span style="color: var(--accent);">&#9096;</span> Windsurf
              </a>
              <a href="/downloads" class="flex items-center gap-1.5 font-mono hover:text-white transition-colors" style="font-size: 12px; color: rgba(255,255,255,0.35);">
                <span style="color: var(--accent);">&#10059;</span> OpenClaw
              </a>
              <a href="/downloads" class="flex items-center gap-1.5 font-mono hover:text-white transition-colors" style="font-size: 12px; color: rgba(255,255,255,0.35);">
                <span style="color: var(--accent);">&#9881;</span> Obsidian
              </a>
              <a href="/downloads" class="flex items-center gap-1.5 font-mono hover:text-white transition-colors" style="font-size: 12px; color: rgba(255,255,255,0.35);">
                <span style="color: var(--accent);">&#9650;</span> Antigravity
              </a>
              <a href="/downloads" class="flex items-center gap-1.5 font-mono hover:text-white transition-colors" style="font-size: 12px; color: rgba(255,255,255,0.35);">
                <span style="color: var(--accent);">&#10070;</span> Codex
              </a>
            </div>

            <p class="font-mono" style="font-size: 11px; color: rgba(255,255,255,0.15);">
              APACHE-2.0 &middot; LOCAL-FIRST &middot; PYTHON 3.11+
            </p>
          </div>
        </div>
      </div>

    </section>

    <!-- ============================================================
         THE PROBLEM
         ============================================================ -->
    <section class="relative z-10 py-16 sm:py-32 px-6">
      <div class="absolute inset-x-0 top-0 h-px" style="background: linear-gradient(90deg, transparent 10%, rgba(212,168,67,0.15) 50%, transparent 90%);"></div>
      <div class="max-w-4xl mx-auto">
        <p class="text-center font-mono tracking-[0.2em] uppercase mb-6" style="font-size: 12px; color: rgba(212,168,67,0.5);">The problem</p>
        <h2 class="text-center font-light mb-10 sm:mb-16" style="font-size: clamp(32px, 5vw, 60px); color: rgba(255,255,255,0.95); letter-spacing: -0.02em; line-height: 1.1;">
          Your agent forgets everything between <span style="color: var(--accent); text-shadow: 0 0 60px rgba(212,168,67,0.4);">sessions.</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
          <div class="card-hover rounded-sm p-6 sm:p-8 h-full relative overflow-hidden">
            <span class="absolute -right-2 -top-4 font-mono font-bold leading-none select-none pointer-events-none" style="font-size: 100px; color: rgba(212,168,67,0.04);">&times;</span>
            <div class="relative z-10">
              <h3 class="font-medium mb-2" style="font-size: 16px; color: rgba(255,255,255,0.9);">Context lost</h3>
              <p style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">Decisions vanish when the window closes. Static files can&rsquo;t retrieve what your agent needs.</p>
            </div>
          </div>
          <div class="card-hover rounded-sm p-6 sm:p-8 h-full relative overflow-hidden">
            <span class="absolute -right-2 -top-4 font-mono font-bold leading-none select-none pointer-events-none" style="font-size: 100px; color: rgba(212,168,67,0.04);">&harr;</span>
            <div class="relative z-10">
              <h3 class="font-medium mb-2" style="font-size: 16px; color: rgba(255,255,255,0.9);">Agents collide</h3>
              <p style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">Two agents edit the same file. One overwrites the other. No awareness, no recovery.</p>
            </div>
          </div>
          <div class="card-hover rounded-sm p-6 sm:p-8 h-full relative overflow-hidden">
            <span class="absolute -right-2 -top-4 font-mono font-bold leading-none select-none pointer-events-none" style="font-size: 100px; color: rgba(212,168,67,0.04);">&#8635;</span>
            <div class="relative z-10">
              <h3 class="font-medium mb-2" style="font-size: 16px; color: rgba(255,255,255,0.9);">Nothing compounds</h3>
              <p style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">Same mistakes, same questions, same blank slate. Every session starts from zero.</p>
            </div>
          </div>
          <div class="card-hover rounded-sm p-6 sm:p-8 h-full relative overflow-hidden">
            <span class="absolute -right-2 -top-4 font-mono font-bold leading-none select-none pointer-events-none" style="font-size: 100px; color: rgba(212,168,67,0.04);">&#9729;</span>
            <div class="relative z-10">
              <h3 class="font-medium mb-2" style="font-size: 16px; color: rgba(255,255,255,0.9);">Someone else&rsquo;s server</h3>
              <p style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">Cloud memory means your context and decisions live on infrastructure you don&rsquo;t control.</p>
            </div>
          </div>
        </div>

        <!-- Terminal Demo -->
        <div class="max-w-3xl mx-auto">
          <div class="rounded-sm border overflow-hidden" style="background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.06);">
            <div class="flex items-center gap-2 px-4 py-3 border-b" style="border-color: rgba(255,255,255,0.06);">
              <div class="w-2.5 h-2.5 rounded-full" style="background: rgba(255,255,255,0.15);"></div>
              <div class="w-2.5 h-2.5 rounded-full" style="background: rgba(255,255,255,0.15);"></div>
              <div class="w-2.5 h-2.5 rounded-full" style="background: rgba(255,255,255,0.15);"></div>
              <span class="text-xs ml-2 font-mono" style="color: rgba(255,255,255,0.2);">omega</span>
            </div>
            <pre class="p-6" style="background: transparent; border: none; font-size: 14px; line-height: 1.8;"><code><span style="color: rgba(255,255,255,0.25);">$</span> <span style="color: rgba(212,168,67,0.7);">pip install omega-memory</span>
<span style="color: rgba(94,201,160,0.8);">&#10003;</span> <span style="color: rgba(255,255,255,0.5);">Installed omega-memory 1.3.0</span>

<span style="color: rgba(255,255,255,0.25);">$</span> <span style="color: rgba(212,168,67,0.7);">omega serve --daemon</span>
<span style="color: rgba(94,201,160,0.8);">&#10003;</span> <span style="color: rgba(255,255,255,0.5);">MCP server running on http://localhost:8377</span>
<span style="color: rgba(255,255,255,0.2);">  15 tools loaded | HTTP transport | 61 MB RSS</span>

<span style="color: rgba(255,255,255,0.25);">$</span> <span style="color: rgba(212,168,67,0.7);">omega_query("that webpack thing that broke prod")</span>
<span style="color: rgba(255,255,255,0.2);">  Reranking 47 candidates &rarr; top 3</span>
<span style="color: rgba(107,159,255,0.8);">  [0.94]</span> <span style="color: rgba(255,255,255,0.6);">webpack config changes broke HMR - reverted to v5.88</span>
<span style="color: rgba(107,159,255,0.8);">  [0.87]</span> <span style="color: rgba(255,255,255,0.6);">production build failing: set NODE_ENV before webpack</span>
<span style="color: rgba(232,160,64,0.8);">  &#9888; contradiction detected with memory #1204</span></code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Amber horizon divider -->
    <div class="amber-horizon"></div>

    <!-- ============================================================
         PIPELINE STAGES
         ============================================================ -->
    <section class="relative z-10 py-16 sm:py-32 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12 sm:mb-16">
          <p class="font-mono tracking-[0.2em] uppercase mb-6" style="font-size: 12px; color: rgba(212,168,67,0.5);">How OMEGA thinks</p>
          <h2 class="font-light" style="font-size: clamp(32px, 5vw, 60px); color: rgba(255,255,255,0.95); letter-spacing: -0.02em; line-height: 1.1;">
            Four stages. One <span style="color: var(--accent); text-shadow: 0 0 60px rgba(212,168,67,0.4);">pipeline.</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 max-w-4xl mx-auto">
          <div class="card-hover rounded-sm p-6 sm:p-8 h-full relative overflow-hidden">
            <span class="absolute -right-2 -top-4 font-mono font-bold leading-none select-none pointer-events-none" style="font-size: 100px; color: rgba(212,168,67,0.04);">01</span>
            <div class="relative z-10">
              <div class="flex items-center gap-3 mb-3">
                <p class="font-mono tracking-[0.2em] uppercase" style="font-size: 11px; color: rgba(212,168,67,0.5);">Stage 01 — Capture</p>
                <span class="font-mono px-2 py-0.5 rounded-sm" style="font-size: 10px; color: rgba(255,255,255,0.3); border: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.02);">Automatic classification</span>
              </div>
              <h3 class="font-light mb-4" style="font-size: 20px; color: rgba(255,255,255,0.9); letter-spacing: -0.01em; line-height: 1.3;">Hooks detect it. You don&rsquo;t lift a finger.</h3>
              <ul class="space-y-2.5">
                <li class="flex items-start gap-2.5" style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">
                  <span class="mt-1.5 flex-shrink-0 w-1 h-1 rounded-full" style="background: rgba(212,168,67,0.5);"></span>
                  Classifies into decisions, lessons, preferences, tasks, or observations
                </li>
                <li class="flex items-start gap-2.5" style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">
                  <span class="mt-1.5 flex-shrink-0 w-1 h-1 rounded-full" style="background: rgba(212,168,67,0.5);"></span>
                  Git hooks, shell hooks, and MCP tool calls — all captured automatically
                </li>
              </ul>
            </div>
          </div>

          <div class="card-hover rounded-sm p-6 sm:p-8 h-full relative overflow-hidden">
            <span class="absolute -right-2 -top-4 font-mono font-bold leading-none select-none pointer-events-none" style="font-size: 100px; color: rgba(212,168,67,0.04);">02</span>
            <div class="relative z-10">
              <div class="flex items-center gap-3 mb-3">
                <p class="font-mono tracking-[0.2em] uppercase" style="font-size: 11px; color: rgba(212,168,67,0.5);">Stage 02 — Embed</p>
                <span class="font-mono px-2 py-0.5 rounded-sm" style="font-size: 10px; color: rgba(255,255,255,0.3); border: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.02);">384-dim</span>
              </div>
              <h3 class="font-light mb-4" style="font-size: 20px; color: rgba(255,255,255,0.9); letter-spacing: -0.01em; line-height: 1.3;">Meaning, not keywords.</h3>
              <ul class="space-y-2.5">
                <li class="flex items-start gap-2.5" style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">
                  <span class="mt-1.5 flex-shrink-0 w-1 h-1 rounded-full" style="background: rgba(212,168,67,0.5);"></span>
                  BGE-small embeddings via ONNX runtime — fast, local, private
                </li>
                <li class="flex items-start gap-2.5" style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">
                  <span class="mt-1.5 flex-shrink-0 w-1 h-1 rounded-full" style="background: rgba(212,168,67,0.5);"></span>
                  Semantic search that understands intent, not just string matching
                </li>
              </ul>
            </div>
          </div>

          <div class="card-hover rounded-sm p-6 sm:p-8 h-full relative overflow-hidden">
            <span class="absolute -right-2 -top-4 font-mono font-bold leading-none select-none pointer-events-none" style="font-size: 100px; color: rgba(212,168,67,0.04);">03</span>
            <div class="relative z-10">
              <div class="flex items-center gap-3 mb-3">
                <p class="font-mono tracking-[0.2em] uppercase" style="font-size: 11px; color: rgba(212,168,67,0.5);">Stage 03 — Store</p>
                <span class="font-mono px-2 py-0.5 rounded-sm" style="font-size: 10px; color: rgba(255,255,255,0.3); border: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.02);">Dedup + evolution</span>
              </div>
              <h3 class="font-light mb-4" style="font-size: 20px; color: rgba(255,255,255,0.9); letter-spacing: -0.01em; line-height: 1.3;">Evolve, don&rsquo;t accumulate.</h3>
              <ul class="space-y-2.5">
                <li class="flex items-start gap-2.5" style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">
                  <span class="mt-1.5 flex-shrink-0 w-1 h-1 rounded-full" style="background: rgba(212,168,67,0.5);"></span>
                  Canonical deduplication prevents bloat — memories merge, not pile up
                </li>
                <li class="flex items-start gap-2.5" style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">
                  <span class="mt-1.5 flex-shrink-0 w-1 h-1 rounded-full" style="background: rgba(212,168,67,0.5);"></span>
                  Intelligent forgetting keeps context fresh and retrieval precise
                </li>
              </ul>
            </div>
          </div>

          <div class="card-hover rounded-sm p-6 sm:p-8 h-full relative overflow-hidden">
            <span class="absolute -right-2 -top-4 font-mono font-bold leading-none select-none pointer-events-none" style="font-size: 100px; color: rgba(212,168,67,0.04);">04</span>
            <div class="relative z-10">
              <div class="flex items-center gap-3 mb-3">
                <p class="font-mono tracking-[0.2em] uppercase" style="font-size: 11px; color: rgba(212,168,67,0.5);">Stage 04 — Retrieve</p>
                <span class="font-mono px-2 py-0.5 rounded-sm" style="font-size: 10px; color: rgba(255,255,255,0.3); border: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.02);">Hybrid</span>
              </div>
              <h3 class="font-light mb-4" style="font-size: 20px; color: rgba(255,255,255,0.9); letter-spacing: -0.01em; line-height: 1.3;">The right memory, every time.</h3>
              <ul class="space-y-2.5">
                <li class="flex items-start gap-2.5" style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">
                  <span class="mt-1.5 flex-shrink-0 w-1 h-1 rounded-full" style="background: rgba(212,168,67,0.5);"></span>
                  Thompson sampling learns what works — semantic + keyword + temporal
                </li>
                <li class="flex items-start gap-2.5" style="font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.6;">
                  <span class="mt-1.5 flex-shrink-0 w-1 h-1 rounded-full" style="background: rgba(212,168,67,0.5);"></span>
                  Contradiction detection flags conflicting memories automatically
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         BENCHMARK
         ============================================================ -->
    <section class="relative z-10 py-16 sm:py-32 px-6">
      <div class="absolute inset-x-0 top-0 h-px" style="background: linear-gradient(90deg, transparent 10%, rgba(212,168,67,0.15) 50%, transparent 90%);"></div>
      <div class="max-w-3xl mx-auto text-center relative">
        <p class="font-mono tracking-[0.2em] uppercase mb-6" style="font-size: 12px; color: rgba(212,168,67,0.5);">Benchmark</p>
        <div class="font-light leading-none mb-2" style="font-size: clamp(80px, 14vw, 160px); color: var(--accent); text-shadow: 0 0 80px rgba(212,168,67,0.35), 0 0 160px rgba(212,168,67,0.12); letter-spacing: -0.04em;">
          95.4%
        </div>
        <p class="font-light mb-2" style="font-size: 20px; color: rgba(255,255,255,0.9);">#1 on LongMemEval — ICLR 2025 — 500 questions</p>
        <p class="max-w-xl mx-auto mb-10" style="font-size: 15px; color: rgba(255,255,255,0.4); line-height: 1.7;">
          LongMemEval is the standard benchmark for AI memory systems. 500 questions testing extraction, reasoning, and cross-session retrieval.
        </p>
        <div class="max-w-md mx-auto space-y-3 text-left">
          <div>
            <div class="flex justify-between text-xs mb-1 font-mono"><span style="color: rgba(255,255,255,0.5);">OMEGA</span><span style="color: var(--accent);">95.4%</span></div>
            <div class="h-1.5 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.04);"><div class="h-full rounded-full" style="width: 95.4%; background: var(--accent); box-shadow: 0 0 12px rgba(212,168,67,0.4);"></div></div>
          </div>
          <div>
            <div class="flex justify-between text-xs mb-1 font-mono"><span style="color: rgba(255,255,255,0.3);">Mastra OM</span><span style="color: rgba(255,255,255,0.25);">94.87%</span></div>
            <div class="h-1.5 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.04);"><div class="h-full rounded-full" style="width: 94.87%; background: rgba(255,255,255,0.12);"></div></div>
          </div>
          <div>
            <div class="flex justify-between text-xs mb-1 font-mono"><span style="color: rgba(255,255,255,0.3);">Zep / Graphiti</span><span style="color: rgba(255,255,255,0.25);">71.2%</span></div>
            <div class="h-1.5 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.04);"><div class="h-full rounded-full" style="width: 71.2%; background: rgba(255,255,255,0.12);"></div></div>
          </div>
          <div>
            <div class="flex justify-between text-xs mb-1 font-mono"><span style="color: rgba(255,255,255,0.3);">No Memory</span><span style="color: rgba(255,255,255,0.25);">49.6%</span></div>
            <div class="h-1.5 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.04);"><div class="h-full rounded-full" style="width: 49.6%; background: rgba(255,255,255,0.12);"></div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Amber horizon divider -->
    <div class="amber-horizon"></div>

    <!-- ============================================================
         FEATURES GRID
         ============================================================ -->
    <section class="relative z-10 py-16 sm:py-32 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12 sm:mb-16">
          <p class="font-mono tracking-[0.2em] uppercase mb-6" style="font-size: 12px; color: rgba(212,168,67,0.5);">Capabilities</p>
          <h2 class="font-light" style="font-size: clamp(32px, 5vw, 60px); color: rgba(255,255,255,0.95); letter-spacing: -0.02em; line-height: 1.1;">
            Everything agents need to <span style="color: var(--accent); text-shadow: 0 0 60px rgba(212,168,67,0.4);">remember</span>
          </h2>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
