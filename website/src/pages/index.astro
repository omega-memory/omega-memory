  <!-- Full-page starfield canvas animation — matches production (fixed, covers all sections) -->
  <script is:inline>
    (function() {
      var c = document.getElementById('starfield');
      if (!c || !c.getContext) return;
      var ctx = c.getContext('2d');
      var stars = [];
      var count = 200;
      function resize() {
        c.width = window.innerWidth;
        c.height = document.documentElement.scrollHeight;
        stars = [];
        for (var i = 0; i < count; i++) {
          stars.push({
            x: Math.random() * c.width,
            y: Math.random() * c.height,
            r: 1.2 * Math.random() + 0.3,
            a: 0.5 * Math.random() + 0.15,
            speed: 0.0008 * Math.random() + 0.0002
          });
        }
      }
      resize();
      window.addEventListener('resize', resize);
      function draw(t) {
        ctx.clearRect(0, 0, c.width, c.height);
        for (var i = 0; i < stars.length; i++) {
          var s = stars[i];
          var flicker = 0.2 * Math.sin(t * s.speed + s.x) + 0.8;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, 2 * Math.PI);
          ctx.fillStyle = 'rgba(255, 220, 160, ' + (s.a * flicker) + ')';
          ctx.fill();
        }
        requestAnimationFrame(draw);
      }
      requestAnimationFrame(draw);
    })();
  </script>

  <!-- Three.js 3D Force Graph + Bokeh Orbs — matches production HeroGraph3D -->
  <script>
    import ForceGraph3D from '3d-force-graph';
    import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
    import * as THREE from 'three';

    const container = document.getElementById('hero-graph');
    if (container) {
      // Node colors matching production type system
      const typeColors: Record<string, string> = {
        decision: '#6b9fff',
        lesson: '#5ec9a0',
        error: '#f06060',
        preference: '#d4a843',
        task: '#40c8c8',
        observation: '#b088e8',
        constraint: '#d4a843',
      };

      // Generate graph data
      const types = Object.keys(typeColors);
      const N = 22;
      const nodes = Array.from({ length: N }, (_, i) => ({
        id: i,
        type: types[Math.floor(Math.random() * types.length)],
        val: Math.random() * 8 + 2,
      }));
      const links: { source: number; target: number }[] = [];
      for (let i = 1; i < N; i++) {
        links.push({ source: i, target: Math.floor(Math.random() * i) });
        if (Math.random() > 0.6) {
          links.push({ source: i, target: Math.floor(Math.random() * N) });
        }
      }

      const graph = ForceGraph3D()(container)
        .graphData({ nodes, links })
        .backgroundColor('#00000000')
        .showNavInfo(false)
        .nodeRelSize(3)
        .nodeVal((n: any) => n.val)
        .nodeColor((n: any) => typeColors[n.type] || '#d4a843')
        .nodeOpacity(0.85)
        .linkWidth(0.3)
        .linkOpacity(0.12)
        .linkColor(() => 'rgba(255,255,255,0.3)')
        .linkDirectionalParticles(1)
        .linkDirectionalParticleWidth(0.6)
        .linkDirectionalParticleSpeed(0.002)
        .enableNodeDrag(false)
        .enableNavigationControls(false)
        .width(container.clientWidth)
        .height(container.clientHeight);

      // Force transparent background on the WebGL renderer
      const renderer = graph.renderer();
      renderer.setClearColor(0x000000, 0);
      renderer.domElement.style.background = 'transparent';

      // === Add large bokeh orbs to the Three.js scene (matches production) ===
      const scene = graph.scene();

      // Orb definitions: large translucent spheres with glow
      const orbDefs = [
        { pos: [250, -20, -80], radius: 80, color: '#d4a843', opacity: 0.35 },
        { pos: [350, 70, -140], radius: 120, color: '#d4a843', opacity: 0.25 },
        { pos: [200, 100, 60], radius: 50, color: '#ff8866', opacity: 0.3 },
        { pos: [150, -80, -120], radius: 55, color: '#d4a843', opacity: 0.2 },
        { pos: [320, -110, 100], radius: 90, color: '#f0a050', opacity: 0.2 },
        { pos: [180, 50, -50], radius: 40, color: '#b088e8', opacity: 0.18 },
        { pos: [400, 40, -30], radius: 140, color: '#d4a843', opacity: 0.18 },
        { pos: [220, -140, -90], radius: 35, color: '#40c8c8', opacity: 0.25 },
      ];

      const orbs: THREE.Mesh[] = [];
      orbDefs.forEach((def) => {
        const geo = new THREE.SphereGeometry(def.radius, 32, 32);
        const mat = new THREE.MeshBasicMaterial({
          color: new THREE.Color(def.color),
          transparent: true,
          opacity: def.opacity,
          depthWrite: false,
        });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set(def.pos[0], def.pos[1], def.pos[2]);
        scene.add(mesh);
        orbs.push(mesh);
      });

      // Add bloom post-processing
      const bloomPass = new UnrealBloomPass(
        new THREE.Vector2(container.clientWidth, container.clientHeight),
        1.5,  // strength (slightly higher for orb glow)
        0.6,  // radius
        0.1   // threshold
      );
      graph.postProcessingComposer().addPass(bloomPass);

      // Auto-rotate camera
      graph.cameraPosition({ x: 350, y: 80, z: 350 });
      let angle = 0;
      function rotate() {
        angle += 0.0008;
        graph.cameraPosition({
          x: 380 * Math.sin(angle),
          y: 40 + 30 * Math.sin(angle * 0.5),
          z: 380 * Math.cos(angle),
        });

        // Gentle drift for orbs
        const t = Date.now() * 0.001;
        orbs.forEach((orb, i) => {
          const speed = 0.15 + i * 0.05;
          const amp = 3 + i * 1.5;
          orb.position.x += Math.sin(t * speed + i) * 0.15;
          orb.position.y += Math.cos(t * speed * 0.7 + i * 2) * 0.1;
        });

        requestAnimationFrame(rotate);
      }
      rotate();

      // Resize handler
      window.addEventListener('resize', () => {
        graph.width(container.clientWidth).height(container.clientHeight);
      });
    }
  </script>
