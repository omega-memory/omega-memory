---
import Base from "./Base.astro";
import { getSessionFromCookie } from "../lib/auth/index";

const { title = "Admin Dashboard - OMEGA" } = Astro.props;

// Auth check
const cookie = Astro.request.headers.get("cookie");
const token = getSessionFromCookie(cookie);
if (!token) {
  return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
---
<Base title={title} hideNav={true} hideFooter={true}>
  <div class="fixed inset-0 z-50 flex flex-col overflow-hidden" style="background:#08090f" data-theme="dark">
    <slot />
  </div>
</Base>
